<Window x:Class="FavGCalSchedulerClone.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FavGCalSchedulerClone" Height="760" Width="1180" MinHeight="720" MinWidth="1040"
        FontFamily="Meiryo UI" FontSize="12"
        Background="#EDF1F5"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="ChromeBrush" Color="#243447" />
        <SolidColorBrush x:Key="ChromeHoverBrush" Color="#31465C" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="GridLineBrush" Color="#CBD5E1" />
        <SolidColorBrush x:Key="MenuBarBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="PanelBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="WeekdayBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SundayBrush" Color="#FFF1F2" />
        <SolidColorBrush x:Key="SaturdayBrush" Color="#EFF6FF" />
        <SolidColorBrush x:Key="HolidayBrush" Color="#FFE4E6" />
        <SolidColorBrush x:Key="OutsideMonthBrush" Color="#F1F5F9" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="FlatMenuStyle" TargetType="Menu">
            <Setter Property="Background" Value="{StaticResource MenuBarBrush}" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="2,1" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,2" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>

        <Style x:Key="MonthNavButton" TargetType="Button">
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#34495E" />
            <Setter Property="BorderBrush" Value="#50657A" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ChromeHoverBrush}" />
                                <Setter Property="BorderBrush" Value="#6B7F93" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1D2A38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DayCell" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource WeekdayBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GridLineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSunday}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SundayBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSaturday}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SaturdayBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                    <Setter Property="Background" Value="{StaticResource OutsideMonthBrush}" />
                    <Setter Property="Opacity" Value="0.78" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHoliday}" Value="True">
                    <Setter Property="Background" Value="{StaticResource HolidayBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWorkdayOverride}" Value="True">
                    <Setter Property="Background" Value="{StaticResource WeekdayBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="BorderBrush" Value="#0F766E" />
                    <Setter Property="BorderThickness" Value="3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EventBar" TargetType="Border">
            <Setter Property="BorderBrush" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Padding" Value="5,0" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="RowHeight" Value="24" />
            <Setter Property="ColumnHeaderHeight" Value="26" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0" />
        </Style>

        <Style x:Key="CalendarMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Header" Value="{Binding Summary}" />
            <Setter Property="IsCheckable" Value="True" />
            <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="StaysOpenOnClick" Value="True" />
            <EventSetter Event="Checked" Handler="CalendarSelectionMenu_Checked" />
            <EventSetter Event="Unchecked" Handler="CalendarSelectionMenu_Unchecked" />
        </Style>
    </Window.Resources>

    <DockPanel Background="#EDF1F5">
        <Menu DockPanel.Dock="Top" Style="{StaticResource FlatMenuStyle}">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="全カレンダーのバックアップ(_B)" Click="BackupAllCalendarsMenu_Click" />
                <MenuItem Header="全カレンダーのリストア(_R)" Click="RestoreAllCalendarsMenu_Click" />
                <Separator />
                <MenuItem Header="FavGCalSchedulerデータ移行..." Click="ImportFavGCalSchedulerMenu_Click" />
                <Separator />
                <MenuItem Header="インポート(_I)" Click="ImportCsvMenu_Click" />
                <MenuItem Header="エクスポート(_E)" Click="ExportCsvMenu_Click" />
                <Separator />
                <MenuItem Header="印刷" Click="PrintMenu_Click" />
                <MenuItem Header="印刷設定" IsEnabled="False" />
                <MenuItem Header="印刷プレビュー" Click="PrintPreviewMenu_Click" />
                <Separator />
                <MenuItem Header="アプリケーションの終了(_X)" Click="ExitMenu_Click" />
            </MenuItem>
            <MenuItem Header="編集(_E)">
                <MenuItem Header="スケジュールの追加(_A)" Click="AddScheduleMenu_Click" />
                <MenuItem Header="ToDoの追加(_D)" Click="AddTodoMenu_Click" />
                <Separator />
                <MenuItem Header="スケジュール一覧(_L)" Click="ScheduleListMenu_Click" />
            </MenuItem>
            <MenuItem Header="表示(_V)">
                <MenuItem Header="月表示(_M)" InputGestureText="F5" Command="{Binding ShowMonthViewCommand}" />
                <MenuItem Header="週表示(_W)" InputGestureText="F6" Command="{Binding ShowWeekViewCommand}" />
                <MenuItem Header="日表示(_D)" InputGestureText="F7" Command="{Binding ShowDayViewCommand}" />
            </MenuItem>
            <MenuItem Header="移動(_M)">
                <MenuItem Header="現在の表示へ(_D)" InputGestureText="Home" Command="{Binding TodayCommand}" />
                <Separator />
                <MenuItem Header="前へ(_P)" InputGestureText="PageUp" Command="{Binding PreviousMonthCommand}" />
                <MenuItem Header="次へ(_N)" InputGestureText="PageDown" Command="{Binding NextMonthCommand}" />
                <Separator />
                <MenuItem Header="大きく前へ(_-)" Command="{Binding PreviousYearCommand}" />
                <MenuItem Header="大きく次へ(_+)" Command="{Binding NextYearCommand}" />
            </MenuItem>
            <MenuItem Header="検索(_S)" Click="SearchMenu_Click" />
            <MenuItem Header="Googleカレンダー(_G)">
                <MenuItem Header="OAuth JSONを選択..." Command="{Binding BrowseOAuthClientCommand}" />
                <MenuItem Header="Google認証" Command="{Binding AuthorizeCommand}" />
                <MenuItem Header="トークン削除" Command="{Binding ClearTokensCommand}" />
                <Separator />
                <MenuItem Header="同期する" InputGestureText="F8" Command="{Binding SyncCommand}" />
                <MenuItem Header="カレンダー一覧を更新" Command="{Binding ReloadCalendarListCommand}" />
                <Separator />
                <MenuItem Header="表示カレンダー" ItemsSource="{Binding AvailableCalendars}" ItemContainerStyle="{StaticResource CalendarMenuItemStyle}" />
            </MenuItem>
            <MenuItem Header="設定(_C)">
                <MenuItem Header="アプリ設定(_A)" Click="SettingsMenu_Click" />
                <MenuItem Header="通知一覧..." Click="ReminderHistoryMenu_Click" />
            </MenuItem>
            <MenuItem Header="ヘルプ(_H)">
                <MenuItem Header="サポートサイト" IsEnabled="False" />
                <Separator />
                <MenuItem Header="バージョン情報(_A)..." Click="AboutMenu_Click" />
            </MenuItem>
        </Menu>

        <Grid DockPanel.Dock="Top" Height="46" Background="{StaticResource ChromeBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Style="{StaticResource MonthNavButton}" Content="{Binding PreviousYearLabel}" Command="{Binding PreviousYearCommand}" />
            <Button Grid.Column="2" Style="{StaticResource MonthNavButton}" Content="{Binding PreviousMonthLabel}" Command="{Binding PreviousMonthCommand}" />
            <StackPanel Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding CurrentPeriodTitle}" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <Button Style="{StaticResource MonthNavButton}" Content="今日" Command="{Binding TodayCommand}"
                        MinWidth="64" Height="20" FontSize="11" Padding="8,0" Margin="0,2,0,0" />
            </StackPanel>
            <Button Grid.Column="4" Style="{StaticResource MonthNavButton}" Content="{Binding NextMonthLabel}" Command="{Binding NextMonthCommand}" />
            <Button Grid.Column="5" Style="{StaticResource MonthNavButton}" Content="{Binding NextYearLabel}" Command="{Binding NextYearCommand}" />
        </Grid>

        <StatusBar DockPanel.Dock="Bottom" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1,1,0,0" Height="26">
            <TextBlock Text="{Binding CalendarStatusText}" Foreground="#475569" />
        </StatusBar>

        <Grid Margin="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="330" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Border BorderBrush="{StaticResource GridLineBrush}" BorderThickness="1" Background="White"
                            Visibility="{Binding IsMonthView, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <UniformGrid Columns="7" Background="#E2E8F0">
                                <TextBlock Text="Sun" Foreground="#B91C1C" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBlock Text="Mon" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBlock Text="Tue" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBlock Text="Wed" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBlock Text="Thu" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBlock Text="Fri" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBlock Text="Sat" Foreground="#1D4ED8" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </UniformGrid>

                            <ListBox x:Name="DayList" Grid.Row="1" ItemsSource="{Binding VisibleCalendarDays}" SelectedItem="{Binding SelectedDay, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     MouseDoubleClick="DayList_MouseDoubleClick">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" Rows="6" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource DayCell}" MouseLeftButtonDown="DayCell_MouseLeftButtonDown">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Top" Text="{Binding Date.Day}" Foreground="#334155"
                                                           FontSize="15" FontWeight="SemiBold" />
                                                <ItemsControl ItemsSource="{Binding Events}" Margin="0,4,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource EventBar}" Background="{Binding DisplayColor}" MouseLeftButtonDown="EventBar_MouseLeftButtonDown">
                                                                <TextBlock Text="{Binding CalendarDisplayText}" FontSize="11" Foreground="#111827"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border BorderBrush="{StaticResource GridLineBrush}" BorderThickness="1" Background="White"
                            Visibility="{Binding IsWeekView, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <UniformGrid Columns="7" Background="#E2E8F0">
                                <TextBlock Text="Sun" Foreground="#B91C1C" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBlock Text="Mon" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBlock Text="Tue" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBlock Text="Wed" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBlock Text="Thu" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBlock Text="Fri" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBlock Text="Sat" Foreground="#1D4ED8" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </UniformGrid>

                            <ListBox Grid.Row="1" ItemsSource="{Binding VisibleCalendarDays}" SelectedItem="{Binding SelectedDay, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     MouseDoubleClick="DayList_MouseDoubleClick">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" Rows="1" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource DayCell}" MouseLeftButtonDown="DayCell_MouseLeftButtonDown">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Top" Text="{Binding Date.Day}" Foreground="#334155"
                                                           FontSize="16" FontWeight="SemiBold" />
                                                <ItemsControl ItemsSource="{Binding Events}" Margin="0,4,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource EventBar}" Background="{Binding DisplayColor}" MouseLeftButtonDown="EventBar_MouseLeftButtonDown">
                                                                <TextBlock Text="{Binding CalendarDisplayText}" FontSize="11" Foreground="#111827"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border BorderBrush="{StaticResource GridLineBrush}" BorderThickness="1" Background="White"
                            Visibility="{Binding IsDayView, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding CurrentPeriodTitle}" FontSize="20" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,10" />
                            <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedDayEvents}" SelectedItem="{Binding SelectedEvent}"
                                      MouseDoubleClick="SelectedDayEventsGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="日時" Binding="{Binding DateDisplayText}" Width="180" />
                                    <DataGridTextColumn Header="件名" Binding="{Binding Title}" Width="220" />
                                    <DataGridTextColumn Header="内容" Binding="{Binding Description}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Column="1" Margin="8,0,0,0" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="1"
                        Background="{StaticResource PanelBrush}"
                        Visibility="{Binding IsMonthView, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#FFFFFF" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="選択日の予定" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8" />
                                <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedDayEvents}" SelectedItem="{Binding SelectedEvent}"
                                          MouseDoubleClick="SelectedDayEventsGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="時間" Binding="{Binding DateDisplayText}" Width="120" />
                                        <DataGridTextColumn Header="件名" Binding="{Binding Title}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Background="#FFFFFF" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="未完了タスク" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8" />
                                <DataGrid Grid.Row="1" ItemsSource="{Binding TodoEvents}" SelectedItem="{Binding SelectedEvent}"
                                          MouseDoubleClick="TodoEventsGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="期限" Binding="{Binding DateDisplayText}" Width="120" />
                                        <DataGridTextColumn Header="件名" Binding="{Binding Title}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
