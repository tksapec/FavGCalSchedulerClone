<Window x:Class="FavGCalSchedulerClone.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FavGCalSchedulerClone" Height="760" Width="1180" MinHeight="720" MinWidth="1040"
        FontFamily="Meiryo UI" FontSize="12"
        Background="#EDF1F5" Opacity="{Binding WindowOpacity}"
        Closing="Window_Closing">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ShowMonthViewCommand}" />
        <KeyBinding Key="F6" Command="{Binding ShowWeekViewCommand}" />
        <KeyBinding Key="F7" Command="{Binding ShowDayViewCommand}" />
        <KeyBinding Key="Home" Command="{Binding TodayCommand}" />
        <KeyBinding Key="PageUp" Command="{Binding PreviousMonthCommand}" />
        <KeyBinding Key="PageDown" Command="{Binding NextMonthCommand}" />
        <KeyBinding Key="F8" Command="{Binding SyncCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <SolidColorBrush x:Key="ChromeBrush" Color="#243447" />
        <SolidColorBrush x:Key="ChromeHoverBrush" Color="#31465C" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="GridLineBrush" Color="#CBD5E1" />
        <SolidColorBrush x:Key="MenuBarBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="PanelBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="WeekdayBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SundayBrush" Color="#FFD6D9" />
        <SolidColorBrush x:Key="SaturdayBrush" Color="#D9E5FF" />
        <SolidColorBrush x:Key="HolidayBrush" Color="#FFD6D9" />
        <SolidColorBrush x:Key="OutsideMonthBrush" Color="#F1F5F9" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <DataTemplate x:Key="ColoredTitleTemplate">
            <Border Background="{Binding DisplayColor}" BorderBrush="#64748B" BorderThickness="1" Margin="1" Padding="4,1"
                    ToolTip="{Binding ToolTipText}">
                <TextBlock Text="{Binding Title}" Foreground="{Binding DisplayForegroundColor}"
                           FontSize="{Binding DataContext.SideListFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           TextTrimming="CharacterEllipsis" />
            </Border>
        </DataTemplate>

        <Style x:Key="FlatMenuStyle" TargetType="Menu">
            <Setter Property="Background" Value="{StaticResource MenuBarBrush}" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="2,1" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,2" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>

        <Style x:Key="MonthNavButton" TargetType="Button">
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#34495E" />
            <Setter Property="BorderBrush" Value="#50657A" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ChromeHoverBrush}" />
                                <Setter Property="BorderBrush" Value="#6B7F93" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1D2A38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MonthNavRepeatButton" TargetType="RepeatButton">
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#34495E" />
            <Setter Property="BorderBrush" Value="#50657A" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Delay" Value="150" />
            <Setter Property="Interval" Value="50" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ChromeHoverBrush}" />
                                <Setter Property="BorderBrush" Value="#6B7F93" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1D2A38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DayCell" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource WeekdayBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GridLineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ClipToBounds" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                    <Setter Property="Background" Value="{StaticResource OutsideMonthBrush}" />
                    <Setter Property="Opacity" Value="0.78" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSunday}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SundayBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSaturday}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SaturdayBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHoliday}" Value="True">
                    <Setter Property="Background" Value="{StaticResource HolidayBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWorkdayOverride}" Value="True">
                    <Setter Property="Background" Value="{StaticResource WeekdayBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#3B82F6" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="BorderBrush" Value="#0F766E" />
                    <Setter Property="BorderThickness" Value="3" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                    <Setter Property="BorderBrush" Value="#F59E0B" />
                    <Setter Property="BorderThickness" Value="3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EventBar" TargetType="Border">
            <Setter Property="BorderBrush" Value="#64748B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Height" Value="19" />
            <Setter Property="Margin" Value="0,1,0,0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style x:Key="EventSegmentBar" TargetType="Border" BasedOn="{StaticResource EventBar}">
            <Setter Property="Background" Value="{Binding DisplayColor}" />
            <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsVisible}" Value="True" />
                        <Condition Binding="{Binding IsWeekSegmentStart}" Value="True" />
                        <Condition Binding="{Binding IsWeekSegmentEnd}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderThickness" Value="1,1,0,1" />
                    <Setter Property="CornerRadius" Value="2,0,0,2" />
                    <Setter Property="Margin" Value="0,1,-1,0" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsVisible}" Value="True" />
                        <Condition Binding="{Binding IsWeekSegmentStart}" Value="False" />
                        <Condition Binding="{Binding IsWeekSegmentEnd}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderThickness" Value="0,1,0,1" />
                    <Setter Property="CornerRadius" Value="0" />
                    <Setter Property="Margin" Value="0,1,-1,0" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsVisible}" Value="True" />
                        <Condition Binding="{Binding IsWeekSegmentStart}" Value="False" />
                        <Condition Binding="{Binding IsWeekSegmentEnd}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderThickness" Value="0,1,1,1" />
                    <Setter Property="CornerRadius" Value="0,2,2,0" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsVisible}" Value="True" />
                        <Condition Binding="{Binding IsSelected}" Value="True" />
                        <Condition Binding="{Binding IsWeekSegmentStart}" Value="True" />
                        <Condition Binding="{Binding IsWeekSegmentEnd}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="#1D4ED8" />
                    <Setter Property="BorderThickness" Value="2" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsVisible}" Value="True" />
                        <Condition Binding="{Binding IsSelected}" Value="True" />
                        <Condition Binding="{Binding IsWeekSegmentStart}" Value="True" />
                        <Condition Binding="{Binding IsWeekSegmentEnd}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="#1D4ED8" />
                    <Setter Property="BorderThickness" Value="2,2,0,2" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsVisible}" Value="True" />
                        <Condition Binding="{Binding IsSelected}" Value="True" />
                        <Condition Binding="{Binding IsWeekSegmentStart}" Value="False" />
                        <Condition Binding="{Binding IsWeekSegmentEnd}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="#1D4ED8" />
                    <Setter Property="BorderThickness" Value="0,2,0,2" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsVisible}" Value="True" />
                        <Condition Binding="{Binding IsSelected}" Value="True" />
                        <Condition Binding="{Binding IsWeekSegmentStart}" Value="False" />
                        <Condition Binding="{Binding IsWeekSegmentEnd}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="#1D4ED8" />
                    <Setter Property="BorderThickness" Value="0,2,2,2" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="RowHeight" Value="24" />
            <Setter Property="ColumnHeaderHeight" Value="26" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0" />
        </Style>

        <Style x:Key="CalendarMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Header" Value="{Binding Summary}" />
            <Setter Property="IsCheckable" Value="True" />
            <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="StaysOpenOnClick" Value="True" />
            <EventSetter Event="Checked" Handler="CalendarSelectionMenu_Checked" />
            <EventSetter Event="Unchecked" Handler="CalendarSelectionMenu_Unchecked" />
        </Style>
    </Window.Resources>

    <DockPanel Background="#EDF1F5">
        <Menu DockPanel.Dock="Top" Style="{StaticResource FlatMenuStyle}">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="全カレンダーのバックアップ(_B)" Command="{Binding BackupAllCalendarsCommand}" />
                <MenuItem Header="全カレンダーのリストア(_R)" Command="{Binding RestoreAllCalendarsCommand}" />
                <Separator />
                <MenuItem Header="FavGCalSchedulerデータ移行..." Command="{Binding ImportFavGCalSchedulerCommand}" />
                <Separator />
                <MenuItem Header="インポート(_I)" Command="{Binding ImportCsvCommand}" />
                <MenuItem Header="エクスポート(_E)" Command="{Binding ExportCsvCommand}" />
            </MenuItem>
            <MenuItem Header="編集(_E)">
                <MenuItem Header="スケジュールの追加(_A)" Command="{Binding AddScheduleCommand}" />
                <MenuItem Header="ToDoの追加(_D)" Command="{Binding AddTodoCommand}" />
                <Separator />
                <MenuItem Header="スケジュール一覧(_L)" Command="{Binding ShowScheduleListCommand}" />
            </MenuItem>
            <MenuItem Header="表示(_V)">
                <MenuItem Header="月表示(_M)" InputGestureText="F5" Command="{Binding ShowMonthViewCommand}" />
                <MenuItem Header="週表示(_W)" InputGestureText="F6" Command="{Binding ShowWeekViewCommand}" />
                <MenuItem Header="日表示(_D)" InputGestureText="F7" Command="{Binding ShowDayViewCommand}" />
            </MenuItem>
            <MenuItem Header="移動(_M)">
                <MenuItem Header="現在の表示へ(_D)" InputGestureText="Home" Command="{Binding TodayCommand}" />
                <Separator />
                <MenuItem Header="前へ(_P)" InputGestureText="PageUp" Command="{Binding PreviousMonthCommand}" />
                <MenuItem Header="次へ(_N)" InputGestureText="PageDown" Command="{Binding NextMonthCommand}" />
                <Separator />
                <MenuItem Header="大きく前へ(_-)" Command="{Binding PreviousYearCommand}" />
                <MenuItem Header="大きく次へ(_+)" Command="{Binding NextYearCommand}" />
            </MenuItem>
            <MenuItem Header="検索(_S)" Command="{Binding SearchCommand}" />
            <MenuItem Header="Googleカレンダー(_G)">
                <MenuItem Header="OAuth JSONを選択..." Command="{Binding BrowseOAuthClientCommand}" />
                <MenuItem Header="Google認証" Command="{Binding AuthorizeCommand}" />
                <MenuItem Header="トークン削除" Command="{Binding ClearTokensCommand}" />
                <Separator />
                <MenuItem Header="同期する" InputGestureText="F8" Command="{Binding SyncCommand}" />
                <MenuItem Header="同期診断..." Command="{Binding ShowSyncDiagnosticsCommand}" />
                <MenuItem Header="カレンダー一覧を更新" Command="{Binding ReloadCalendarListCommand}" />
                <Separator />
                <MenuItem Header="表示カレンダー" ItemsSource="{Binding AvailableCalendars}" ItemContainerStyle="{StaticResource CalendarMenuItemStyle}" />
            </MenuItem>
            <MenuItem Header="設定(_C)">
                <MenuItem Header="アプリ設定(_A)" Command="{Binding ShowSettingsCommand}" />
                <MenuItem Header="通知一覧..." Command="{Binding ShowReminderHistoryCommand}" />
            </MenuItem>
            <MenuItem Header="ヘルプ(_H)">
                <MenuItem Header="バージョン情報(_A)..." Command="{Binding ShowAboutCommand}" />
            </MenuItem>
        </Menu>

        <Grid DockPanel.Dock="Top" Height="46" Background="{StaticResource ChromeBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <RepeatButton Grid.Column="1" Style="{StaticResource MonthNavRepeatButton}" Content="{Binding PreviousYearLabel}" Command="{Binding PreviousYearCommand}" />
            <RepeatButton Grid.Column="2" Style="{StaticResource MonthNavRepeatButton}" Content="{Binding PreviousMonthLabel}" Command="{Binding PreviousMonthCommand}" />
            <StackPanel Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding CurrentPeriodTitle}" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <Button Style="{StaticResource MonthNavButton}" Content="今日" Command="{Binding TodayCommand}"
                        MinWidth="64" Height="20" FontSize="11" Padding="8,0" Margin="0,2,0,0" />
            </StackPanel>
            <RepeatButton Grid.Column="4" Style="{StaticResource MonthNavRepeatButton}" Content="{Binding NextMonthLabel}" Command="{Binding NextMonthCommand}" />
            <RepeatButton Grid.Column="5" Style="{StaticResource MonthNavRepeatButton}" Content="{Binding NextYearLabel}" Command="{Binding NextYearCommand}" />
        </Grid>

        <StatusBar DockPanel.Dock="Bottom" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1,1,0,0" Height="26">
            <StatusBarItem>
                <TextBlock Text="{Binding CalendarStatusText}" Foreground="#475569" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" Foreground="#334155" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="90" Height="12" IsIndeterminate="{Binding IsSynchronizing}" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="330" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Border BorderBrush="{StaticResource GridLineBrush}" BorderThickness="1" Background="White"
                            Visibility="{Binding IsMonthView, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ItemsControl ItemsSource="{Binding WeekdayHeaders}" Background="#E2E8F0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ListBox x:Name="DayList" Grid.Row="1" ItemsSource="{Binding VisibleCalendarDays}" SelectedItem="{Binding SelectedDay, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     MouseDoubleClick="DayList_MouseDoubleClick">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" Rows="6" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource DayCell}" AllowDrop="True"
                                                MouseLeftButtonDown="DayCell_MouseLeftButtonDown" MouseRightButtonDown="DayCell_MouseRightButtonDown"
                                                DragEnter="DayCell_DragOver" DragOver="DayCell_DragOver" DragLeave="DayCell_DragLeave" Drop="DayCell_Drop">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Top" Text="{Binding Date.Day}" Foreground="#334155"
                                                           FontSize="15" FontWeight="SemiBold" Margin="5,5,5,0" />
                                                <ItemsControl ItemsSource="{Binding Segments}" Margin="0,4,0,0" HorizontalAlignment="Stretch" ClipToBounds="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource EventSegmentBar}"
                                                                    PreviewMouseLeftButtonDown="EventSegment_PreviewMouseLeftButtonDown"
                                                                    PreviewMouseMove="EventSegment_PreviewMouseMove"
                                                                    MouseLeftButtonDown="EventSegment_MouseLeftButtonDown"
                                                                    MouseRightButtonDown="EventSegment_MouseRightButtonDown">
                                                                <DockPanel LastChildFill="True" VerticalAlignment="Center">
                                                                    <Border DockPanel.Dock="Left" Width="12" Height="12" Background="White" BorderBrush="#475569" BorderThickness="1"
                                                                            Margin="0,0,3,0" Visibility="{Binding ShowTodoIndicator, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                        <TextBlock Text="{Binding TodoCheckGlyph}" Foreground="#DC2626" FontSize="11" FontWeight="Bold"
                                                                                   Margin="-1,-3,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding DisplayText}" FontSize="{Binding DataContext.CalendarLabelFontSize, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{Binding DisplayForegroundColor}"
                                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                </DockPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border BorderBrush="{StaticResource GridLineBrush}" BorderThickness="1" Background="White"
                            Visibility="{Binding IsWeekView, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ItemsControl ItemsSource="{Binding WeekdayHeaders}" Background="#E2E8F0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ListBox Grid.Row="1" ItemsSource="{Binding VisibleCalendarDays}" SelectedItem="{Binding SelectedDay, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     MouseDoubleClick="DayList_MouseDoubleClick">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" Rows="1" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource DayCell}" AllowDrop="True"
                                                MouseLeftButtonDown="DayCell_MouseLeftButtonDown" MouseRightButtonDown="DayCell_MouseRightButtonDown"
                                                DragEnter="DayCell_DragOver" DragOver="DayCell_DragOver" DragLeave="DayCell_DragLeave" Drop="DayCell_Drop">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Top" Text="{Binding Date.Day}" Foreground="#334155"
                                                           FontSize="16" FontWeight="SemiBold" Margin="5,5,5,0" />
                                                <ItemsControl ItemsSource="{Binding Segments}" Margin="0,4,0,0" HorizontalAlignment="Stretch" ClipToBounds="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource EventSegmentBar}"
                                                                    PreviewMouseLeftButtonDown="EventSegment_PreviewMouseLeftButtonDown"
                                                                    PreviewMouseMove="EventSegment_PreviewMouseMove"
                                                                    MouseLeftButtonDown="EventSegment_MouseLeftButtonDown"
                                                                    MouseRightButtonDown="EventSegment_MouseRightButtonDown">
                                                                <DockPanel LastChildFill="True" VerticalAlignment="Center">
                                                                    <Border DockPanel.Dock="Left" Width="12" Height="12" Background="White" BorderBrush="#475569" BorderThickness="1"
                                                                            Margin="0,0,3,0" Visibility="{Binding ShowTodoIndicator, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                        <TextBlock Text="{Binding TodoCheckGlyph}" Foreground="#DC2626" FontSize="11" FontWeight="Bold"
                                                                                   Margin="-1,-3,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding DisplayText}" FontSize="{Binding DataContext.CalendarLabelFontSize, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{Binding DisplayForegroundColor}"
                                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                </DockPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border BorderBrush="{StaticResource GridLineBrush}" BorderThickness="1" Background="White"
                            Visibility="{Binding IsDayView, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding CurrentPeriodTitle}" FontSize="20" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,10" />
                            <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedDayEvents}" SelectedItem="{Binding SelectedEvent}"
                                      MouseDoubleClick="SelectedDayEventsGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="日時" Binding="{Binding DateDisplayText}" Width="180" />
                                    <DataGridTemplateColumn Header="件名" CellTemplate="{StaticResource ColoredTitleTemplate}" Width="220" />
                                    <DataGridTextColumn Header="内容" Binding="{Binding Description}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Column="1" Margin="8,0,0,0" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="1"
                        Background="{StaticResource PanelBrush}"
                        Visibility="{Binding IsMonthView, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#FFFFFF" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="選択日の予定" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8" />
                                <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedDayEvents}" SelectedItem="{Binding SelectedEvent}"
                                          PreviewMouseRightButtonDown="SidePanelEventsGrid_PreviewMouseRightButtonDown"
                                          MouseDoubleClick="SelectedDayEventsGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="日時" Binding="{Binding DateDisplayText}" Width="132" />
                                        <DataGridTemplateColumn Header="件名" CellTemplate="{StaticResource ColoredTitleTemplate}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Background="#FFFFFF" Padding="8">
                            <TabControl SelectedIndex="{Binding SelectedTodoTabIndex, Mode=TwoWay}">
                                <TabItem Header="未完了タスク">
                                    <DataGrid ItemsSource="{Binding TodoEvents}" SelectedItem="{Binding SelectedEvent}"
                                              PreviewMouseRightButtonDown="SidePanelEventsGrid_PreviewMouseRightButtonDown"
                                              MouseDoubleClick="TodoEventsGrid_MouseDoubleClick">
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOverdueTodo}" Value="True">
                                                        <Setter Property="Background" Value="#FDE2E2" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="#2563EB" />
                                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="期限" Binding="{Binding DateDisplayText}" Width="88" />
                                            <DataGridTemplateColumn Header="件名" CellTemplate="{StaticResource ColoredTitleTemplate}" Width="*" />
                                            <DataGridTextColumn Header="%" Binding="{Binding TodoProgressText}" Width="40" />
                                            <DataGridTextColumn Header="P" Binding="{Binding TodoPriorityDisplayText}" Width="30" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                                <TabItem Header="処理済みタスク">
                                    <DataGrid ItemsSource="{Binding CompletedTodoEvents}" SelectedItem="{Binding SelectedEvent}"
                                              PreviewMouseRightButtonDown="SidePanelEventsGrid_PreviewMouseRightButtonDown"
                                              MouseDoubleClick="TodoEventsGrid_MouseDoubleClick">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="期限" Binding="{Binding DateDisplayText}" Width="88" />
                                            <DataGridTemplateColumn Header="件名" CellTemplate="{StaticResource ColoredTitleTemplate}" Width="*" />
                                            <DataGridTextColumn Header="%" Binding="{Binding TodoProgressText}" Width="40" />
                                            <DataGridTextColumn Header="P" Binding="{Binding TodoPriorityDisplayText}" Width="30" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
